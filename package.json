{
  "name": "spectro",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "svelte-kit sync",
    "env:dev": "dotenv -e .env.development --",
    "env:prod": "dotenv -e .env.production --",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fmt": "prettier . --experimental-cli --check --cache-location .prettiercache",
    "fmt:fix": "prettier . --experimental-cli --write --cache-location .prettiercache",
    "lint:eslint": "eslint --cache --concurrency auto",
    "lint:svelte": "svelte-check --fail-on-warnings",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@iconify-icons/ic": "^1.2.13",
    "@iconify-icons/simple-icons": "^1.2.74",
    "@iconify/svelte": "^5.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@noble/ed25519": "^3.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@sveltejs/kit": "^2.70.2",
    "@vercel/otel": "^2.1.3",
    "drizzle-orm": "^0.45.2",
    "inngest": "^4.18.0",
    "pg": "^8.22.0",
    "svelte": "^5.56.8",
    "valibot": "^1.4.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.4.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@bastidood/eslint-plugin-imsort": "^0.12.0",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.64.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "daisyui": "^5.7.16",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
