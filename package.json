{
  "name": "spectro",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "svelte-kit sync",
    "env:dev": "dotenv -e .env.development --",
    "env:prod": "dotenv -e .env.production --",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fmt": "prettier . --experimental-cli --check --cache-location .prettiercache",
    "fmt:fix": "prettier . --experimental-cli --write --cache-location .prettiercache",
    "lint:eslint": "eslint --cache --concurrency auto",
    "lint:svelte": "svelte-check --fail-on-warnings",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@iconify-icons/ic": "^2.0.0",
    "@iconify-icons/simple-icons": "^2.0.7",
    "@iconify/svelte": "^5.2.3",
    "@neondatabase/serverless": "^1.2.0",
    "@noble/ed25519": "^3.2.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.76.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@sveltejs/kit": "^3.1.0",
    "@vercel/otel": "^2.1.3",
    "drizzle-orm": "^0.45.4",
    "inngest": "^4.26.0",
    "pg": "^8.23.1",
    "svelte": "^5.57.2",
    "valibot": "^1.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.5.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@bastidood/eslint-plugin-imsort": "^0.12.0",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.67.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sveltejs/adapter-vercel": "^7.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "daisyui": "^5.7.50",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
